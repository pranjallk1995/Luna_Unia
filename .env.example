# Copy this file to .env and replace every placeholder before starting Unia.

# Who may use this app, among the people Luna Sentia lets sign in: blank (the default) for
# Sentia's owner only, * for all of them, or a comma-separated list. The owner always may.
# LUNAUNIA_ALLOWED_EMAILS=*

# Where browsers open each app from Unia's cards. With a tunnel, give the pattern of the
# apps' public hostnames, where {app} becomes visia, vita, lumia, fiora, lexia, vibia, or socia.
# Leave it blank to open each app at its localhost port (Fiora 18500 ... Vita 18506).
LUNAUNIA_URL_TEMPLATE=
# Optional: one app's address, when it does not follow the pattern.
LUNAVISIA_URL=
LUNAVITA_URL=
LUNALUMIA_URL=
LUNAFIORA_URL=
LUNALEXIA_URL=
LUNAVIBIA_URL=
LUNASOCIA_URL=
# Luna Sentia's card opens its user settings at LUNA_SSO_URL, with links to Adminer
# (localhost:19000 by default) and the model monitor (localhost:19003). Set their public
# addresses if your tunnel routes them; the monitor must be under the sign-in's cookie domain.
LUNASENTIA_URL=
LUNASENTIA_MONITOR_URL=
# Sentia's card also links to its ComfyUI (localhost:19002 by default); it has no sign-in,
# so keep it off the tunnel unless something else guards it.
LUNASENTIA_COMFYUI_URL=

# Single sign-on through Luna Sentia: the auth service's public address (SENTIA_AUTH_PUBLIC_URL
# in Luna_Sentia/.env), and its address on luna_sentia_network; https://auth.example.com
# with a tunnel.
LUNA_SSO_URL=http://localhost:19001
LUNA_SSO_INTERNAL_URL=http://luna-sentia-auth:8000
