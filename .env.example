# Copy this file to .env and replace every placeholder before starting Unia.

# Comma-separated, verified Google accounts allowed to use Unia.
LUNAUNIA_ALLOWED_EMAILS=you@example.com

# Where browsers open each app from Unia's cards. With a tunnel, give the pattern of the
# apps' public hostnames, where {app} becomes visia, vita, lumia, fiora, lexia, or vibia.
# Leave it blank to open each app at its localhost port (Visia 18501 ... Vibia 18506).
LUNAUNIA_URL_TEMPLATE=https://{app}.example.com
# Optional: one app's address, when it does not follow the pattern.
LUNAVISIA_URL=
LUNAVITA_URL=
LUNALUMIA_URL=
LUNAFIORA_URL=
LUNALEXIA_URL=
LUNAVIBIA_URL=
# Luna Sentia's card opens Adminer (localhost:19080 by default).
LUNASENTIA_URL=

# Single sign-on through Luna Sentia: the auth service's public address (SENTIA_AUTH_PUBLIC_URL
# in Luna_Sentia/.env), and its address on luna_sentia_network.
LUNA_SSO_URL=https://auth.example.com
LUNA_SSO_INTERNAL_URL=http://luna-sentia-auth:8000
